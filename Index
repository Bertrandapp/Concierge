  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"><\/script>

  <script>
  // ===== RÉSIDENCES =====
  const RESIDENCES = [
    'QK - Alexandrite 27','QK - Alexandrite 29','QK - Béryl 21','QK - Béryl 23',
    'QK - Corail B2','QK - Corail B3','QK - Corail B4','QK - Corail B5',
    'QK - Corail B6','QK - Corail B7','QK - Corail B8','QK - Corail B9',
    'QK - Olivine','QK - Onyx','QK - Parking 1 & 2','QK - Rubis 111',
    'QK - Rubis 113','QK - Tourmaline'
  ];

  // ===== ÉTAT =====
  let APP = {
    apiKey:'', aiEnabled:true, exifEnabled:true,
    concierge:'', dateJour:'', prestations:[],
    form:{ photoDebutBase64:null, photoFinBase64:null, heureDebut:'', heureFin:'', nature:'', aiSuggestion:'', editIndex:null }
  };

  function today() { return new Date().toISOString().split('T')[0]; }
  function getCurrentTime() { const n=new Date(); return String(n.getHours()).padStart(2,'0')+':'+String(n.getMinutes()).padStart(2,'0'); }

  function calcDuree(debut, fin) {
    if (!debut||!fin) return null;
    const [dh,dm]=debut.split(':').map(Number);
    const [fh,fm]=fin.split(':').map(Number);
    const totalMin=(fh*60+fm)-(dh*60+dm);
    if (totalMin<0) return null;
    const h=Math.floor(totalMin/60), m=totalMin%60;
    return { h, m, totalMin, label: totalMin===0?'0min':(h>0?h+'h'+String(m).padStart(2,'0'):m+'min') };
  }

  function calcTotalJour() {
    let total=0;
    APP.prestations.forEach(p=>{ if(p.heureDebut&&p.heureFin){const d=calcDuree(p.heureDebut,p.heureFin);if(d)total+=d.totalMin;} });
    const h=Math.floor(total/60), m=total%60;
    return { totalMin:total, label:h+'h'+String(m).padStart(2,'0') };
  }

  function save() {
    try {
      const toSave={...APP,prestations:APP.prestations.map(p=>({...p,photoDebutBase64:null,photoFinBase64:null}))};
      localStorage.setItem('concierge_app',JSON.stringify(toSave));
    } catch(e){}
  }

  function load() {
    try {
      const d=localStorage.getItem('concierge_app');
      if(d){
        const parsed=JSON.parse(d);
        if(parsed.dateJour&&parsed.dateJour!==today()){parsed.prestations=[];parsed.dateJour=today();}
        APP={...APP,...parsed};
      }
    } catch(e){}
  }

  function showToast(msg,type='ok') {
    const t=document.getElementById('toast');
    t.textContent=msg;
    t.className='toast show'+(type==='err'?' error':type==='gold'?' gold':type==='info'?' info':'');
    setTimeout(()=>t.classList.remove('show'),3000);
  }
  function showLoading(txt='Analyse en cours...') { document.getElementById('loadingTxt').textContent=txt; document.getElementById('loadingOverlay').classList.add('active'); }
  function hideLoading() { document.getElementById('loadingOverlay').classList.remove('active'); }

  // ===== NAVIGATION =====
  function goPage(name) {
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    document.getElementById('page'+name).classList.add('active');
    document.getElementById('nav'+name).classList.add('active');
    if(name==='Rapport') renderPrestations();
    if(name==='Export')  renderExportTable();
  }
  function openModal(id) { document.getElementById(id).classList.add('active'); }
  function closeModal(id) { document.getElementById(id).classList.remove('active'); }

  // ===== ACCUEIL =====
  function selectConcierge(nom) {
    APP.concierge=nom;
    document.getElementById('btnNuno').classList.toggle('selected',nom==='Nuno');
    document.getElementById('btnThierry').classList.toggle('selected',nom==='Thierry');
    document.getElementById('btnStartDay').disabled=!nom;
  }

  function startDay() {
    if(!APP.concierge){showToast('❌ Sélectionne ton nom','err');return;}
    APP.dateJour=today();
    save(); updateUI(); goPage('Rapport');
    showToast('✅ Journée démarrée — '+APP.concierge);
  }

  function updateUI() {
    const dateLabel=new Date().toLocaleDateString('fr-FR',{day:'numeric',month:'short',year:'numeric'});
    document.getElementById('dateBadge').textContent=dateLabel;
    if(APP.concierge){
      document.getElementById('activeConciergeLabel').textContent='👷 '+APP.concierge;
      document.getElementById('activeDateLabel').textContent='📅 '+new Date().toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long'});
      document.getElementById('btnNuno').classList.toggle('selected',APP.concierge==='Nuno');
      document.getElementById('btnThierry').classList.toggle('selected',APP.concierge==='Thierry');
    }
    document.getElementById('settingsApiKey').value=APP.apiKey||'';
    document.getElementById('settingsAI').checked=APP.aiEnabled!==false;
    document.getElementById('settingsEXIF').checked=APP.exifEnabled!==false;
    populateResidenceSelects();
  }

  function populateResidenceSelects() {
    ['inputResidence','editResidence'].forEach(id=>{
      const sel=document.getElementById(id);
      if(!sel) return;
      const current=sel.value;
      sel.innerHTML='<option value="">— Choisir un bâtiment —</option>';
      RESIDENCES.forEach(r=>{
        const opt=document.createElement('option');
        opt.value=r; opt.textContent=r;
        if(r===current) opt.selected=true;
        sel.appendChild(opt);
      });
    });
  }

  // ===== SETTINGS =====
  function openSettings() {
    document.getElementById('settingsApiKey').value=APP.apiKey||'';
    document.getElementById('settingsAI').checked=APP.aiEnabled!==false;
    document.getElementById('settingsEXIF').checked=APP.exifEnabled!==false;
    openModal('modalSettings');
  }
  function saveSettings() {
    APP.apiKey=document.getElementById('settingsApiKey').value.trim();
    APP.aiEnabled=document.getElementById('settingsAI').checked;
    APP.exifEnabled=document.getElementById('settingsEXIF').checked;
    save(); closeModal('modalSettings'); showToast('⚙️ Paramètres enregistrés');
  }
  function resetAllData() {
    if(!confirm('⚠️ Effacer toutes les prestations du jour ?')) return;
    APP.prestations=[]; save(); closeModal('modalSettings'); renderPrestations(); showToast('🗑️ Données effacées','info');
  }

  // ===== EXIF =====
  function extractEXIFDate(file) {
    return new Promise(resolve=>{
      if(!APP.exifEnabled){resolve(null);return;}
      const reader=new FileReader();
      reader.onload=function(e){
        try{
          const arr=new Uint8Array(e.target.result);
          const str=String.fromCharCode(...arr.slice(0,65536));
          const match=str.match(/(\d{4}):(\d{2}):(\d{2}) (\d{2}):(\d{2}):(\d{2})/);
          if(match) resolve(match[4]+':'+match[5]); else resolve(null);
        }catch(err){resolve(null);}
      };
      reader.onerror=()=>resolve(null);
      reader.readAsArrayBuffer(file.slice(0,65536));
    });
  }

  // ===== PHOTOS =====
  async function handlePhoto(event,type) {
    const file=event.target.files[0];
    if(!file||!file.type.startsWith('image/')){showToast('❌ Fichier image requis','err');return;}
    showLoading(type==='debut'?'Lecture photo de début...':'Lecture photo de fin...');
    try{
      const exifTime=await extractEXIFDate(file);
      const heure=exifTime||getCurrentTime();
      const source=exifTime?'📷 EXIF':'🕐 Heure actuelle';
      const base64=await resizeAndConvert(file,800);
      if(type==='debut'){
        APP.form.photoDebutBase64=base64; APP.form.heureDebut=heure;
        const prev=document.getElementById('photoDebutPreview');
        prev.src=base64; prev.classList.add('show');
        document.getElementById('photoDebutPlaceholder').style.display='none';
        document.getElementById('photoDebutTime').textContent=source+' — '+heure;
        document.getElementById('photoDebutZone').classList.add('has-photo');
        document.getElementById('inputHeureDebut').value=heure;
        hideLoading();
        if(APP.aiEnabled&&APP.apiKey) analyzePhotoWithAI(base64);
      } else {
        APP.form.photoFinBase64=base64; APP.form.heureFin=heure;
        const prev=document.getElementById('photoFinPreview');
        prev.src=base64; prev.classList.add('show');
        document.getElementById('photoFinPlaceholder').style.display='none';
        document.getElementById('photoFinTime').textContent=source+' — '+heure;
        document.getElementById('photoFinZone').classList.add('has-photo');
        document.getElementById('inputHeureFin').value=heure;
        hideLoading(); showToast('✅ Photo de fin — '+heure);
      }
    }catch(err){hideLoading();showToast('❌ Erreur lecture photo','err');}
  }

  function resizeAndConvert(file,maxWidth) {
    return new Promise((resolve,reject)=>{
      const reader=new FileReader();
      reader.onload=function(e){
        const img=new Image();
        img.onload=function(){
          const canvas=document.createElement('canvas');
          let w=img.width,h=img.height;
          if(w>maxWidth){h=Math.round(h*maxWidth/w);w=maxWidth;}
          canvas.width=w; canvas.height=h;
          canvas.getContext('2d').drawImage(img,0,0,w,h);
          resolve(canvas.toDataURL('image/jpeg',0.75));
        };
        img.onerror=reject; img.src=e.target.result;
      };
      reader.onerror=reject; reader.readAsDataURL(file);
    });
  }

  // ===== FORMULAIRE =====
  function openNewPrestation() {
    if(!APP.concierge){showToast('❌ Sélectionne d\'abord ton nom','err');goPage('Accueil');return;}
    APP.form={photoDebutBase64:null,photoFinBase64:null,heureDebut:'',heureFin:'',nature:'',aiSuggestion:'',editIndex:null};
    ['photoDebutPreview','photoFinPreview'].forEach(id=>{const el=document.getElementById(id);el.classList.remove('show');el.src='';});
    ['photoDebutPlaceholder','photoFinPlaceholder'].forEach(id=>document.getElementById(id).style.display='block');
    ['photoDebutTime','photoFinTime'].forEach(id=>document.getElementById(id).textContent='');
    ['photoDebutZone','photoFinZone'].forEach(id=>document.getElementById(id).classList.remove('has-photo'));
    ['photoDebutInput','photoFinInput'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('inputNature').value='';
    document.getElementById('inputHeureDebut').value='';
    document.getElementById('inputHeureFin').value='';
    document.getElementById('inputResidence').value='';
    document.getElementById('aiSuggestion').classList.remove('show');
    document.getElementById('modalPrestationTitle').textContent='➕ Nouvelle prestation';
    openModal('modalPrestation');
  }

  function confirmAI() { document.getElementById('inputNature').value=APP.form.aiSuggestion; document.getElementById('aiSuggestion').classList.remove('show'); showToast('✅ Nature confirmée'); }
  function modifyAI() { document.getElementById('inputNature').value=APP.form.aiSuggestion; document.getElementById('aiSuggestion').classList.remove('show'); document.getElementById('inputNature').focus(); showToast('✏️ Modifie la nature','info'); }

  function savePrestation() {
    const nature=document.getElementById('inputNature').value.trim();
    const residence=document.getElementById('inputResidence').value;
    const hDebut=document.getElementById('inputHeureDebut').value;
    const hFin=document.getElementById('inputHeureFin').value;
    if(!nature){showToast('❌ Indique la nature des travaux','err');document.getElementById('inputNature').focus();return;}
    if(!hDebut){showToast('❌ L\'heure de début est requise','err');return;}
    const duree=hFin?calcDuree(hDebut,hFin):null;
    const prestation={
      id:Date.now(), date:APP.dateJour||today(), concierge:APP.concierge,
      residence:residence||'', nature, heureDebut:hDebut, heureFin:hFin||'',
      duree:duree?duree.label:'', dureeMin:duree?duree.totalMin:0,
      statut:hFin?'terminee':'en-cours',
      photoDebutBase64:APP.form.photoDebutBase64,
      photoFinBase64:APP.form.photoFinBase64
    };
    APP.prestations.push(prestation);
    save(); closeModal('modalPrestation'); renderPrestations();
    showToast('✅ Prestation enregistrée — '+nature,'gold');
  }

  // ===== RENDU =====
  function renderPrestations() {
    const list=document.getElementById('prestationsList');
    const count=document.getElementById('prestationsCount');
    const total=document.getElementById('totalCard');
    const nb=APP.prestations.length;
    count.textContent=nb+(nb<=1?' prestation':' prestations');
    if(nb===0){
      list.innerHTML='<div class="empty-state"><div class="empty-state-icon">📋</div><div class="empty-state-title">Aucune prestation</div><div class="empty-state-sub">Clique sur le bouton ci-dessous<br>pour enregistrer ta première prestation.</div></div>';
      total.style.display='none'; return;
    }
    list.innerHTML='';
    APP.prestations.forEach((p,i)=>{
      const card=document.createElement('div');
      card.className='prestation-card '+(p.statut||'en-cours');
      const photosHtml=buildPhotosHtml(p);
      const dureeHtml=p.statut==='terminee'
        ?'<span class="prestation-temps">⏱ '+(p.duree||'0min')+'</span>'
        :'<span style="color:var(--orange);font-size:0.8em;">⏳ En cours</span>';
      card.innerHTML=
        '<div class="prestation-top"><div class="prestation-nature">🔧 '+p.nature+'</div>'+
        '<div class="prestation-status '+(p.statut||'en-cours')+'">'+(p.statut==='terminee'?'✅ Terminée':'🔄 En cours')+'</div></div>'+
        '<div class="prestation-meta">'+
        (p.residence?'<span>📍 '+p.residence+'</span>':'')+
        '<span>🕐 '+p.heureDebut+' → '+(p.heureFin?p.heureFin:'...')+'</span></div>'+
        dureeHtml+photosHtml+
        '<div class="prestation-actions"><button class="btn-orange" onclick="openEdit('+i+')">✏️ Modifier</button>'+
        (p.statut!=='terminee'?'<button class="btn-orange" onclick="terminerPrestation('+i+')" style="background:rgba(46,213,115,0.12);border-color:var(--green);color:var(--green);">✅ Terminer</button>':'')+
        '</div>';
      list.appendChild(card);
    });
    const t=calcTotalJour();
    total.style.display='block';
    document.getElementById('totalTemps').textContent=t.label;
    document.getElementById('totalNb').textContent=nb;
    document.getElementById('totalSub').textContent=APP.concierge+' — '+new Date().toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'});
  }

  function buildPhotosHtml(p) {
    if(!p.photoDebutBase64&&!p.photoFinBase64) return '';
    let html='<div class="prestation-photos">';
    if(p.photoDebutBase64) html+='<img class="prestation-thumb" src="'+p.photoDebutBase64+'" alt="Début" onclick="openLightbox(\''+p.photoDebutBase64.replace(/'/g,'')+'\')">'; 
    if(p.photoFinBase64) html+='<img class="prestation-thumb" src="'+p.photoFinBase64+'" alt="Fin" onclick="openLightbox(\''+p.photoFinBase64.replace(/'/g,'')+'\')">'; 
    return html+'</div>';
  }

  function terminerPrestation(index) {
    const p=APP.prestations[index];
    const hFin=getCurrentTime();
    p.heureFin=hFin; p.statut='terminee';
    const d=calcDuree(p.heureDebut,hFin);
    if(d){p.duree=d.label;p.dureeMin=d.totalMin;}
    save(); renderPrestations(); showToast('✅ Prestation terminée — '+hFin);
  }

  function openEdit(index) {
    const p=APP.prestations[index];
    APP.form.editIndex=index;
    document.getElementById('editIndex').value=index;
    document.getElementById('editNature').value=p.nature;
    document.getElementById('editHeureDebut').value=p.heureDebut||'';
    document.getElementById('editHeureFin').value=p.heureFin||'';
    populateResidenceSelects();
    document.getElementById('editResidence').value=p.residence||'';
    openModal('modalEdit');
  }

  function saveEdit() {
    const i=parseInt(document.getElementById('editIndex').value);
    const p=APP.prestations[i]; if(!p) return;
    p.nature=document.getElementById('editNature').value.trim()||p.nature;
    p.heureDebut=document.getElementById('editHeureDebut').value||p.heureDebut;
    p.heureFin=document.getElementById('editHeureFin').value||'';
    p.residence=document.getElementById('editResidence').value||p.residence;
    if(p.heureFin){const d=calcDuree(p.heureDebut,p.heureFin);p.duree=d?d.label:'0min';p.dureeMin=d?d.totalMin:0;p.statut='terminee';}
    else{p.duree='';p.dureeMin=0;p.statut='en-cours';}
    save(); closeModal('modalEdit'); renderPrestations(); showToast('✅ Prestation modifiée');
  }

  function deletePrestation() {
    const i=parseInt(document.getElementById('editIndex').value);
    if(!confirm('Supprimer cette prestation ?')) return;
    APP.prestations.splice(i,1); save(); closeModal('modalEdit'); renderPrestations(); showToast('🗑️ Supprimée','info');
  }

  // ===== LIGHTBOX =====
  function openLightbox(src) { document.getElementById('lightboxImg').src=src; document.getElementById('lightbox').classList.add('active'); }
  function closeLightbox() { document.getElementById('lightbox').classList.remove('active'); document.getElementById('lightboxImg').src=''; }

  // ===== EXPORT TABLE =====
  function renderExportTable() {
    const tbody=document.getElementById('exportTableBody');
    if(!APP.prestations.length){
      tbody.innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:20px;">Aucune prestation enregistrée</td></tr>'; return;
    }
    tbody.innerHTML='';
    APP.prestations.forEach(p=>{
      const tr=document.createElement('tr');
      const dateLabel=new Date(p.date).toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'numeric'});
      tr.innerHTML='<td>'+dateLabel+'</td><td>'+(p.concierge||'—')+'</td><td>'+(p.residence||'—')+'</td>'+
        '<td>'+(p.heureDebut||'—')+'</td><td>'+(p.heureFin||'—')+'</td>'+
        '<td style="color:var(--gold);font-weight:700;">'+(p.duree||'—')+'</td><td>'+(p.nature||'—')+'</td>';
      tbody.appendChild(tr);
    });
  }

  // ===== EXPORT EXCEL =====
  async function exportExcel() {
    if(!APP.prestations.length){showToast('❌ Aucune prestation à exporter','err');return;}
    showLoading('Génération Excel...');
    try{
      const wb=XLSX.utils.book_new();
      const dateLabel=new Date(APP.dateJour||today()).toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'numeric'});
      const headers=['Date','Intervenant','Bâtiment','Heure début','Heure fin','Temps presté','Nature des travaux'];
      const rows=APP.prestations.map(p=>[dateLabel,p.concierge||'',p.residence||'',p.heureDebut||'',p.heureFin||'',p.duree||'',p.nature||'']);
      const total=calcTotalJour();
      const totalRow=['','','','','TOTAL',total.label,APP.prestations.length+' prestation(s)'];
      const ws=XLSX.utils.aoa_to_sheet([headers,...rows,[],totalRow]);
      ws['!cols']=[{wch:12},{wch:14},{wch:24},{wch:12},{wch:10},{wch:14},{wch:40}];
      const categories={};
      APP.prestations.forEach(p=>{const k=p.nature||'Autre';if(!categories[k])categories[k]={count:0,totalMin:0};categories[k].count++;categories[k].totalMin+=p.dureeMin||0;});
      const wsRecap=XLSX.utils.aoa_to_sheet([['Nature des travaux','Nb interventions','Temps total'],...Object.entries(categories).map(([n,d])=>{const h=Math.floor(d.totalMin/60),m=d.totalMin%60;return[n,d.count,h>0?h+'h'+String(m).padStart(2,'0'):m+'min'];})]);
      wsRecap['!cols']=[{wch:40},{wch:18},{wch:14}];
      XLSX.utils.book_append_sheet(wb,ws,'Rapport journalier');
      XLSX.utils.book_append_sheet(wb,wsRecap,'Récap par travaux');
      const dateFile=(APP.dateJour||today()).replace(/-/g,'');
      XLSX.writeFile(wb,'Rapport_'+(APP.concierge||'Concierge')+'_'+dateFile+'.xlsx');
      hideLoading(); showToast('📥 Excel exporté','gold');
    }catch(err){hideLoading();showToast('❌ Erreur export : '+err.message,'err');}
