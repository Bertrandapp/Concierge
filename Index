<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rapport Concierge</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --bg: #0f1923; --bg2: #1a2535; --bg3: #1e2d42;
      --accent: #00d4ff; --accent2: #0099cc;
      --green: #2ed573; --orange: #ffa502; --red: #ff4757;
      --purple: #a29bfe; --gold: #ffd700;
      --text: #e0e0e0; --muted: #7f8c9a; --nav-h: 65px;
    }
    body { font-family:'Segoe UI',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; padding-bottom:var(--nav-h); }

    /* HEADER */
    .header { background:var(--bg2); padding:14px 16px 12px; border-bottom:1px solid rgba(0,212,255,0.15); position:sticky; top:0; z-index:100; display:flex; align-items:center; justify-content:space-between; }
    .header-logo { display:flex; align-items:center; gap:10px; }
    .header-logo-icon { font-size:1.6em; }
    .header-logo-title { font-size:1.05em; font-weight:800; color:var(--accent); letter-spacing:0.5px; }
    .header-logo-sub { font-size:0.72em; color:var(--muted); margin-top:1px; }
    .header-right { display:flex; align-items:center; gap:8px; }
    .settings-btn { background:rgba(255,255,255,0.08); border:none; color:var(--text); width:36px; height:36px; border-radius:10px; cursor:pointer; font-size:1.1em; transition:background 0.2s; }
    .settings-btn:hover { background:rgba(255,255,255,0.15); }
    .date-badge { background:rgba(0,212,255,0.12); border:1px solid rgba(0,212,255,0.3); color:var(--accent); padding:5px 12px; border-radius:20px; font-size:0.8em; font-weight:700; }

    /* PAGES */
    .page { display:none; padding:16px; animation:fadeIn 0.25s ease; }
    .page.active { display:block; }
    @keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

    /* BOTTOM NAV */
    .bottom-nav { position:fixed; bottom:0; left:0; right:0; height:var(--nav-h); background:var(--bg2); border-top:1px solid rgba(255,255,255,0.08); display:flex; z-index:200; }
    .nav-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; cursor:pointer; border:none; background:transparent; color:var(--muted); font-size:0.72em; font-weight:600; transition:color 0.2s; padding:8px 0; }
    .nav-item .nav-icon { font-size:1.5em; }
    .nav-item.active { color:var(--accent); }
    .nav-item.active .nav-icon { filter:drop-shadow(0 0 6px rgba(0,212,255,0.6)); }

    /* CARDS */
    .card { background:var(--bg2); border-radius:14px; padding:16px; margin-bottom:14px; border:1px solid rgba(255,255,255,0.07); }
    .card-title { font-size:0.85em; color:var(--accent); font-weight:700; margin-bottom:12px; display:flex; align-items:center; gap:6px; }

    /* ACCUEIL */
    .welcome-banner { background:linear-gradient(135deg,rgba(0,212,255,0.12),rgba(0,153,204,0.06)); border:1px solid rgba(0,212,255,0.25); border-radius:14px; padding:18px 16px; margin-bottom:16px; text-align:center; }
    .welcome-banner-icon { font-size:2.5em; margin-bottom:8px; }
    .welcome-banner-title { font-size:1.15em; font-weight:800; color:var(--accent); margin-bottom:4px; }
    .welcome-banner-sub { font-size:0.82em; color:var(--muted); }
    .concierge-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px; }
    .concierge-btn { background:var(--bg2); border:2px solid rgba(255,255,255,0.1); border-radius:14px; padding:20px 12px; cursor:pointer; text-align:center; transition:all 0.25s; color:var(--text); }
    .concierge-btn:hover { border-color:var(--accent); background:rgba(0,212,255,0.08); transform:translateY(-2px); }
    .concierge-btn.selected { border-color:var(--accent); background:rgba(0,212,255,0.12); box-shadow:0 0 20px rgba(0,212,255,0.2); }
    .concierge-btn-icon { font-size:2em; margin-bottom:8px; }
    .concierge-btn-name { font-size:1em; font-weight:700; }
    .concierge-btn-role { font-size:0.75em; color:var(--muted); margin-top:3px; }
    .section-title { font-size:1em; font-weight:700; color:var(--text); margin-bottom:10px; margin-top:4px; }

    /* FORMULAIRE */
    .form-group { margin-bottom:14px; }
    .form-label { font-size:0.82em; color:var(--muted); margin-bottom:6px; display:block; font-weight:600; }
    .form-input { width:100%; padding:11px 14px; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.15); border-radius:10px; color:var(--text); font-size:0.95em; }
    .form-input:focus { outline:none; border-color:var(--accent); }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }

    /* BOUTONS */
    .btn-primary { width:100%; padding:14px; border-radius:12px; border:none; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; font-weight:700; font-size:1em; cursor:pointer; transition:all 0.2s; letter-spacing:0.3px; }
    .btn-primary:hover { opacity:0.88; transform:translateY(-1px); }
    .btn-primary:disabled { background:#2a3444; color:var(--muted); cursor:not-allowed; transform:none; }
    .btn-secondary { width:100%; padding:12px; border-radius:12px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:var(--text); font-weight:600; font-size:0.95em; cursor:pointer; transition:all 0.2s; }
    .btn-secondary:hover { background:rgba(255,255,255,0.12); }
    .btn-green { width:100%; padding:14px; border-radius:12px; border:none; background:linear-gradient(135deg,#27ae60,#2ed573); color:#fff; font-weight:700; font-size:1em; cursor:pointer; transition:all 0.2s; }
    .btn-green:hover { opacity:0.88; transform:translateY(-1px); }
    .btn-danger { width:100%; padding:12px; border-radius:12px; border:none; background:rgba(255,71,87,0.15); border:1px solid var(--red); color:var(--red); font-weight:700; font-size:0.95em; cursor:pointer; }
    .btn-orange { padding:9px 16px; border-radius:10px; border:none; background:rgba(255,165,2,0.15); border:1px solid var(--orange); color:var(--orange); font-weight:700; font-size:0.85em; cursor:pointer; transition:all 0.2s; }
    .btn-orange:hover { background:rgba(255,165,2,0.25); }

    /* PHOTO */
    .photo-zone { border:2px dashed rgba(255,255,255,0.15); border-radius:12px; padding:20px; text-align:center; cursor:pointer; transition:all 0.2s; position:relative; overflow:hidden; }
    .photo-zone:hover { border-color:var(--accent); background:rgba(0,212,255,0.04); }
    .photo-zone.has-photo { border-color:var(--green); border-style:solid; padding:8px; }
    .photo-zone input[type="file"] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
    .photo-zone-icon { font-size:2em; margin-bottom:6px; }
    .photo-zone-label { font-size:0.82em; color:var(--muted); }
    .photo-zone-time { font-size:0.9em; font-weight:700; color:var(--green); margin-top:6px; }
    .photo-preview { width:100%; border-radius:8px; max-height:140px; object-fit:cover; display:none; }
    .photo-preview.show { display:block; }

    /* AI */
    .ai-suggestion { background:linear-gradient(135deg,rgba(162,155,254,0.12),rgba(124,58,237,0.08)); border:1px solid rgba(162,155,254,0.35); border-radius:12px; padding:14px; margin-bottom:14px; display:none; }
    .ai-suggestion.show { display:block; }
    .ai-suggestion-label { font-size:0.75em; color:var(--purple); font-weight:700; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
    .ai-suggestion-text { font-size:0.95em; font-weight:700; color:var(--text); margin-bottom:10px; }
    .ai-suggestion-btns { display:flex; gap:8px; }
    .ai-confirm-btn { flex:1; padding:9px; border-radius:9px; border:none; background:rgba(46,213,115,0.15); border:1px solid var(--green); color:var(--green); font-weight:700; font-size:0.85em; cursor:pointer; }
    .ai-modify-btn { flex:1; padding:9px; border-radius:9px; border:none; background:rgba(255,165,2,0.12); border:1px solid var(--orange); color:var(--orange); font-weight:700; font-size:0.85em; cursor:pointer; }

    /* PRESTATIONS */
    .prestations-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
    .prestations-count { background:rgba(0,212,255,0.12); border:1px solid rgba(0,212,255,0.3); color:var(--accent); padding:4px 12px; border-radius:20px; font-size:0.8em; font-weight:700; }
    .prestation-card { background:rgba(0,0,0,0.25); border-radius:12px; padding:14px; margin-bottom:10px; border:1px solid rgba(255,255,255,0.07); border-left:3px solid var(--accent); }
    .prestation-card.en-cours { border-left-color:var(--orange); }
    .prestation-card.terminee { border-left-color:var(--green); }
    .prestation-top { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:8px; }
    .prestation-nature { font-weight:700; font-size:0.95em; flex:1; }
    .prestation-status { font-size:0.72em; font-weight:700; padding:3px 10px; border-radius:20px; white-space:nowrap; margin-left:8px; }
    .prestation-status.en-cours { background:rgba(255,165,2,0.15); color:var(--orange); border:1px solid var(--orange); }
    .prestation-status.terminee { background:rgba(46,213,115,0.15); color:var(--green); border:1px solid var(--green); }
    .prestation-meta { display:flex; gap:12px; flex-wrap:wrap; font-size:0.78em; color:var(--muted); margin-bottom:8px; }
    .prestation-meta span { display:flex; align-items:center; gap:4px; }
    .prestation-temps { font-size:0.88em; font-weight:700; color:var(--gold); }
    .prestation-actions { display:flex; gap:8px; margin-top:10px; }
    .prestation-photos { display:flex; gap:8px; margin-top:8px; }
    .prestation-thumb { width:52px; height:52px; border-radius:8px; object-fit:cover; border:1px solid rgba(255,255,255,0.1); cursor:pointer; }

    /* TOTAL */
    .total-card { background:linear-gradient(135deg,rgba(255,215,0,0.1),rgba(255,165,2,0.06)); border:1px solid rgba(255,215,0,0.3); border-radius:14px; padding:16px; margin-bottom:14px; }
    .total-row { display:flex; justify-content:space-between; align-items:center; }
    .total-label { font-size:0.85em; color:var(--muted); }
    .total-val { font-size:1.4em; font-weight:800; color:var(--gold); }
    .total-sub { font-size:0.78em; color:var(--muted); margin-top:4px; }

    /* EXPORT PAGE */
    .export-preview { background:rgba(0,0,0,0.25); border-radius:12px; padding:14px; margin-bottom:14px; overflow-x:auto; }
    .export-table { width:100%; border-collapse:collapse; font-size:0.78em; min-width:500px; }
    .export-table th { background:rgba(0,212,255,0.12); color:var(--accent); padding:8px 10px; text-align:left; font-weight:700; border-bottom:1px solid rgba(0,212,255,0.2); white-space:nowrap; }
    .export-table td { padding:8px 10px; border-bottom:1px solid rgba(255,255,255,0.05); color:var(--text); vertical-align:middle; }
    .export-table tr:last-child td { border-bottom:none; }
    .export-table tr:hover td { background:rgba(255,255,255,0.03); }

    /* MODAL */
    .modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:500; padding:16px; align-items:flex-end; }
    .modal.active { display:flex; }
    .modal-sheet { background:var(--bg3); border-radius:20px 20px 0 0; width:100%; max-height:92vh; overflow-y:auto; padding:20px 18px 30px; animation:slideUp 0.3s ease; }
    @keyframes slideUp { from{transform:translateY(100%)} to{transform:translateY(0)} }
    .modal-handle { width:40px; height:4px; background:rgba(255,255,255,0.2); border-radius:2px; margin:0 auto 18px; }
    .modal-title { font-size:1.15em; font-weight:700; margin-bottom:18px; color:var(--accent); }
    .modal-close { width:100%; padding:12px; background:none; border:none; color:var(--muted); cursor:pointer; margin-top:10px; font-size:0.9em; }

    /* SETTINGS */
    .settings-row { display:flex; align-items:center; justify-content:space-between; padding:12px 0; border-bottom:1px solid rgba(255,255,255,0.06); }
    .settings-row:last-child { border-bottom:none; }
    .settings-row-label { font-size:0.88em; }
    .settings-row-sub { font-size:0.75em; color:var(--muted); margin-top:2px; }

    /* LOADING */
    #loadingOverlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.88); z-index:999; flex-direction:column; align-items:center; justify-content:center; }
    #loadingOverlay.active { display:flex; }
    .spinner { width:44px; height:44px; border:4px solid rgba(0,212,255,0.15); border-top-color:var(--accent); border-radius:50%; animation:spin 0.9s linear infinite; }
    @keyframes spin { to{transform:rotate(360deg)} }
    .loading-txt { color:var(--accent); margin-top:14px; font-size:0.95em; }

    /* TOAST */
    .toast { position:fixed; bottom:calc(var(--nav-h) + 12px); left:50%; transform:translateX(-50%) translateY(20px); background:#1e3a2e; border:1px solid var(--green); color:var(--green); padding:10px 22px; border-radius:30px; font-size:0.88em; font-weight:600; z-index:999; opacity:0; transition:all 0.3s; white-space:nowrap; }
    .toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
    .toast.error { background:#3a1e1e; border-color:var(--red); color:var(--red); }
    .toast.gold  { background:#2a1e00; border-color:var(--gold); color:var(--gold); }
    .toast.info  { background:#1e2a3a; border-color:var(--accent); color:var(--accent); }

    /* EMPTY */
    .empty-state { text-align:center; padding:40px 20px; color:var(--muted); }
    .empty-state-icon { font-size:3em; margin-bottom:12px; }
    .empty-state-title { font-size:0.95em; font-weight:700; margin-bottom:6px; color:var(--text); }
    .empty-state-sub { font-size:0.82em; line-height:1.6; }

    /* CONCIERGE BAR */
    .active-concierge-bar { background:rgba(0,212,255,0.08); border:1px solid rgba(0,212,255,0.2); border-radius:10px; padding:10px 14px; margin-bottom:14px; display:flex; align-items:center; justify-content:space-between; }
    .active-concierge-name { font-weight:700; font-size:0.95em; }
    .active-concierge-sub { font-size:0.75em; color:var(--muted); margin-top:2px; }
    .change-btn { background:none; border:1px solid rgba(255,255,255,0.15); color:var(--muted); padding:5px 12px; border-radius:8px; font-size:0.78em; cursor:pointer; transition:all 0.2s; }
    .change-btn:hover { border-color:var(--accent); color:var(--accent); }

    /* LIGHTBOX */
    .lightbox { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.95); z-index:600; align-items:center; justify-content:center; }
    .lightbox.active { display:flex; }
    .lightbox img { max-width:95vw; max-height:90vh; border-radius:12px; object-fit:contain; }
    .lightbox-close { position:absolute; top:16px; right:16px; background:rgba(255,255,255,0.15); border:none; color:#fff; width:40px; height:40px; border-radius:50%; font-size:1.2em; cursor:pointer; }

    @media (max-width:380px) { .concierge-grid{grid-template-columns:1fr} .form-row{grid-template-columns:1fr} }
  </style>
</head>
<body>

  <!-- HEADER -->
  <div class="header">
    <div class="header-logo">
      <div class="header-logo-icon">🏢</div>
      <div>
        <div class="header-logo-title">Rapport Concierge</div>
        <div class="header-logo-sub">Quartier des Kessales</div>
      </div>
    </div>
    <div class="header-right">
      <div class="date-badge" id="dateBadge">—</div>
      <button class="settings-btn" onclick="openSettings()">⚙️</button>
    </div>
  </div>

  <!-- PAGE ACCUEIL -->
  <div class="page active" id="pageAccueil">
    <div class="welcome-banner">
      <div class="welcome-banner-icon">👷</div>
      <div class="welcome-banner-title">Rapport Journalier</div>
      <div class="welcome-banner-sub">Sélectionne ton nom pour commencer</div>
    </div>
    <div class="section-title">Qui es-tu aujourd'hui ?</div>
    <div class="concierge-grid">
      <button class="concierge-btn" id="btnNuno" onclick="selectConcierge('Nuno')">
        <div class="concierge-btn-icon">👷</div>
        <div class="concierge-btn-name">Nuno</div>
        <div class="concierge-btn-role">Concierge</div>
      </button>
      <button class="concierge-btn" id="btnThierry" onclick="selectConcierge('Thierry')">
        <div class="concierge-btn-icon">🔧</div>
        <div class="concierge-btn-name">Thierry</div>
        <div class="concierge-btn-role">Concierge</div>
      </button>
    </div>
    <button class="btn-primary" id="btnStartDay" onclick="startDay()" disabled>
      ▶ Commencer la journée
    </button>
  </div>

  <!-- PAGE RAPPORT -->
  <div class="page" id="pageRapport">
    <div class="active-concierge-bar">
      <div>
        <div class="active-concierge-name" id="activeConciergeLabel">—</div>
        <div class="active-concierge-sub" id="activeDateLabel">—</div>
      </div>
      <button class="change-btn" onclick="goPage('Accueil')">Changer</button>
    </div>
    <div class="prestations-header">
      <div class="section-title" style="margin:0;">Prestations du jour</div>
      <div class="prestations-count" id="prestationsCount">0 prestation</div>
    </div>
    <div id="prestationsList">
      <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <div class="empty-state-title">Aucune prestation</div>
        <div class="empty-state-sub">Clique sur le bouton ci-dessous<br>pour enregistrer ta première prestation.</div>
      </div>
    </div>
    <div class="total-card" id="totalCard" style="display:none;">
      <div class="total-row">
        <div>
          <div class="total-label">Temps total presté</div>
          <div class="total-val" id="totalTemps">0h00</div>
        </div>
        <div style="text-align:right;">
          <div class="total-label">Prestations</div>
          <div class="total-val" id="totalNb">0</div>
        </div>
      </div>
      <div class="total-sub" id="totalSub">—</div>
    </div>
    <button class="btn-primary" onclick="openNewPrestation()" style="margin-bottom:10px;">➕ Nouvelle prestation</button>
    <button class="btn-secondary" onclick="goPage('Export')">📊 Voir le rapport & exporter</button>
  </div>

  <!-- PAGE EXPORT -->
  <div class="page" id="pageExport">
    <div class="card">
      <div class="card-title">📊 Récapitulatif du jour</div>
      <div class="export-preview">
        <table class="export-table" id="exportTable">
          <thead>
            <tr>
              <th>Date</th><th>Intervenant</th><th>Bâtiment</th>
              <th>Début</th><th>Fin</th><th>Temps</th><th>Nature des travaux</th>
            </tr>
          </thead>
          <tbody id="exportTableBody">
            <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:20px;">Aucune prestation enregistrée</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <button class="btn-primary" onclick="exportExcel()" style="margin-bottom:10px;">📥 Exporter en Excel</button>
    <button class="btn-green" onclick="exportPDFWithPhotos()" style="margin-bottom:10px;">📄 Générer rapport PDF (avec photos)</button>
  </div>

  <!-- BOTTOM NAV -->
  <nav class="bottom-nav">
    <button class="nav-item active" id="navAccueil" onclick="goPage('Accueil')"><span class="nav-icon">🏠</span>Accueil</button>
    <button class="nav-item" id="navRapport" onclick="goPage('Rapport')"><span class="nav-icon">📋</span>Rapport</button>
    <button class="nav-item" id="navExport" onclick="goPage('Export')"><span class="nav-icon">📊</span>Export</button>
  </nav>

  <!-- MODAL NOUVELLE PRESTATION -->
  <div class="modal" id="modalPrestation">
    <div class="modal-sheet">
      <div class="modal-handle"></div>
      <div class="modal-title" id="modalPrestationTitle">➕ Nouvelle prestation</div>
      <div class="form-group">
        <label class="form-label">📸 Photo de début (heure extraite automatiquement)</label>
        <div class="photo-zone" id="photoDebutZone">
          <input type="file" id="photoDebutInput" accept="image/*" capture="environment" onchange="handlePhoto(event,'debut')">
          <img class="photo-preview" id="photoDebutPreview" src="" alt="">
          <div id="photoDebutPlaceholder"><div class="photo-zone-icon">📷</div><div class="photo-zone-label">Prendre ou importer une photo</div></div>
          <div class="photo-zone-time" id="photoDebutTime"></div>
        </div>
      </div>
      <div class="ai-suggestion" id="aiSuggestion">
        <div class="ai-suggestion-label">🤖 Suggestion IA</div>
        <div class="ai-suggestion-text" id="aiSuggestionText">Analyse en cours...</div>
        <div class="ai-suggestion-btns">
          <button class="ai-confirm-btn" onclick="confirmAI()">✅ Confirmer</button>
          <button class="ai-modify-btn" onclick="modifyAI()">✏️ Modifier</button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">🔧 Nature des travaux</label>
        <input type="text" class="form-input" id="inputNature" placeholder="Ex: Remplacement serrure, tonte pelouse...">
      </div>
      <div class="form-group">
        <label class="form-label">📍 Bâtiment</label>
        <select class="form-input" id="inputResidence"></select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">⏰ Heure début</label>
          <input type="time" class="form-input" id="inputHeureDebut">
        </div>
